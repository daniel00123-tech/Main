# Runtime credentials — never commit real values.
# Former-company (Nirvana, Aquilo, Urban Maintenance) values are forbidden.
# Set these only for Caddington, HT Business or EL Business.

# BigChange
BIGCHANGE_AUTH_MODE=api_key
BIGCHANGE_BASE_URL=
BIGCHANGE_USERNAME=
BIGCHANGE_PASSWORD=
BIGCHANGE_API_KEY=

# Freshdesk
FRESHDESK_SUBDOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_OPEN_STATUS_IDS=

# FixFlo / Fixflow
FIXFLO_BASE_URL=
FIXFLO_API_KEY=

# Report email (KPI automation). Leave blank until the destination is an approved environment.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_TO_EMAIL=
SMTP_CC_EMAIL=
