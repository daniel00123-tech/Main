# Repository environment variable names only.
# Copy values locally. Never commit real secrets.
#
# This repo has two independent parts:
#   1) INFRA  — infra/  (Cloudflare Workers + D1 + Vite)
#   2) Python automations — scripts/ (Aquilo / Dandara). Not used by INFRA.

# =============================================================================
# INFRA — required for local API / Cloud Agent (also see
# infra/packages/api/.dev.vars.example which wrangler actually loads)
# =============================================================================
SESSION_SECRET=local-dev-session-secret-change-before-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INITIAL_PLATFORM_ADMIN_EMAIL=admin@infra.local
INITIAL_PLATFORM_ADMIN_PASSWORD=ChangeMeBeforeProduction!
ENVIRONMENT=development
# Empty so the session cookie is scoped to localhost (production wrangler.toml
# pins portal domains that break browser login on localhost).
PORTAL_COOKIE_DOMAIN=
PORTAL_BASE_DOMAIN=

# =============================================================================
# INFRA — optional local integrations (leave unset unless you are testing that path)
# =============================================================================
# RESEND_API_KEY=
# OPENAI_API_KEY=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
# CADDINGTON_MCP_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# INFRA — production-only Worker secrets (wrangler secret put). Never put values here.
# =============================================================================
# SESSION_SECRET
# CADDINGTON_MCP_AUTH_TOKEN HT_MCP_AUTH_TOKEN EL_MCP_AUTH_TOKEN
# INFRA_CREDENTIAL_WRAPPING_KEY INFRA_CREDENTIAL_KEY_VERSION
# XERO_CLIENT_ID XERO_CLIENT_SECRET XERO_OAUTH_REDIRECT_URI
# MICROSOFT_TENANT_ID MICROSOFT_CLIENT_ID MICROSOFT_CLIENT_SECRET
# CADDINGTON_ADMIN_TOKEN
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT AZURE_DOCUMENT_INTELLIGENCE_KEY
# WHATSAPP_WEBHOOK_VERIFY_TOKEN WHATSAPP_ACCESS_TOKEN META_APP_SECRET
# WHATSAPP_REGISTRATION_PIN WHATSAPP_META_PROBE_KEY
# STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET STRIPE_WEBHOOK_SECRET_INFRASTACK
# EMAIL_LIVE_TEST_KEY EMAIL_SENDING_API_TOKEN
# AUTO_TOPUP_EXECUTION_ENABLED
# CLOUDFLARE_API_TOKEN   # only for: npm run download-base --workspace=@infra/caddington-mcp

# =============================================================================
# Python automations (scripts/) — unused by INFRA Cloud Agent
# =============================================================================
# BIGCHANGE_AUTH_MODE=
# BIGCHANGE_BASE_URL=
# BIGCHANGE_API_KEY=
# BIGCHANGE_USERNAME=
# BIGCHANGE_PASSWORD=
# FIXFLO_API_KEY=
# FIXFLO_BASE_URL=
# DRY_RUN=true
