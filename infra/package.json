{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "description": "INFRA — administration and control platform for business AI infrastructure",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@infra/api",
    "dev:web": "npm run dev --workspace=@infra/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate:local": "npm run db:migrate:local --workspace=@infra/api",
    "db:seed:local": "npm run db:seed:local --workspace=@infra/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
